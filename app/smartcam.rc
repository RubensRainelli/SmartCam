        BEGIN
            VALUE "CompanyName", "Rubens Rainelli\0"
            VALUE "FileDescription", "SmartCam\0"
            VALUE "FileVersion", "2.1.1.0\0"
            VALUE "InternalName", "SmartCam.exe\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Rubens Rainelli (PEFL v1.0)\0"
            VALUE "OriginalFilename", "SmartCam.exe\0"
            VALUE "ProductName", "SmartCam\0"
            VALUE "ProductVersion", "2.1.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
